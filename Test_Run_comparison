import torch
import torch.nn as nn
import torch.optim as optim
import torch.quantization as quant
from torch.utils.data import DataLoader, TensorDataset, random_split
import os, csv, time
import matplotlib.pyplot as plt
import pandas as pd

# === CONFIG ===
base_config = {
    'modes': 32,
    'width': 256,
    'epochs': 2,
    'batch_size': 128,
    'dt': 0.0208,
    'nu': 1e-4,
    'grid_size': 32,
    'train_samples': 9000,
    'val_samples': 1000
}

# === MODEL DEFINITIONS ===
class SpectralConv2d(nn.Module):
    def __init__(self, in_channels, out_channels, modes):
        super().__init__()
        self.weights = nn.Parameter(
            torch.randn(in_channels, out_channels, modes, modes, dtype=torch.cfloat) * 0.02
        )
        self.modes = modes

    def compl_mul2d(self, input, weights):
        return torch.einsum("bixy, ioxy -> boxy", input, weights)

    def forward(self, x):
        B, C, H, W = x.shape
        x_ft = torch.fft.fft2(x, norm="ortho")
        x_ft = x_ft[:, :, :self.modes, :self.modes]
        out_ft = torch.zeros(B, self.weights.shape[1], H, W, dtype=torch.cfloat, device=x.device)
        out_ft[:, :, :self.modes, :self.modes] = self.compl_mul2d(x_ft, self.weights)
        return torch.fft.ifft2(out_ft, norm="ortho").real

class SimpleFNO(nn.Module):
    def __init__(self, modes, width):
        super().__init__()
        self.fc0 = nn.Linear(1, width)
        self.conv1 = SpectralConv2d(width, width, modes)
        self.conv2 = SpectralConv2d(width, width, modes)
        self.w1 = nn.Conv2d(width, width, 1)
        self.w2 = nn.Conv2d(width, width, 1)
        self.fc1 = nn.Linear(width, 128)
        self.relu1 = nn.ReLU()
        self.fc2 = nn.Linear(128, 1)

    def forward(self, x):
        x = self.fc0(x.unsqueeze(-1)).permute(0, 3, 1, 2)
        x = self.relu1(self.conv1(x) + self.w1(x))
        x = self.relu1(self.conv2(x) + self.w2(x))
        x = x.permute(0, 2, 3, 1)
        x = self.fc2(self.relu1(self.fc1(x)))
        return x.squeeze(-1)

class QuantizedFNOSelective(nn.Module):
    def __init__(self, modes, width):
        super().__init__()
        self.fc0 = nn.Linear(1, width)
        self.conv1 = SpectralConv2d(width, width, modes)
        self.conv2 = SpectralConv2d(width, width, modes)
        self.w1 = nn.Conv2d(width, width, 1)
        self.w2 = nn.Conv2d(width, width, 1)
        self.quant = quant.QuantStub()
        self.fc1 = nn.Linear(width, 128)
        self.relu1 = nn.ReLU()
        self.fc2 = nn.Linear(128, 1)
        self.dequant = quant.DeQuantStub()

    def forward(self, x):
        x = self.fc0(x.unsqueeze(-1)).permute(0, 3, 1, 2)
        x = self.relu1(self.conv1(x) + self.w1(x))
        x = self.relu1(self.conv2(x) + self.w2(x))
        x = x.permute(0, 2, 3, 1)
        x = self.quant(x)
        x = self.fc2(self.relu1(self.fc1(x)))
        x = self.dequant(x)
        return x.squeeze(-1)

def fuse_model(model):
    quant.fuse_modules(model, [['fc1', 'relu1']], inplace=True)

# === UTILS ===
def train_epoch(model, loader, optimizer, loss_fn, device):
    model.train()
    total_loss = 0
    for xb, yb in loader:
        xb, yb = xb.to(device), yb.to(device)
        optimizer.zero_grad()
        pred = model(xb)
        loss = loss_fn(pred, yb)
        loss.backward()
        optimizer.step()
        total_loss += loss.item() * xb.size(0)
    return total_loss / len(loader.dataset)

def test_model(model, loader, device):
    model.eval()
    total_rel_err = 0
    with torch.no_grad():
        for xb, yb in loader:
            xb, yb = xb.to(device), yb.to(device)
            pred = model(xb)
            rel_err = torch.norm(pred - yb) / torch.norm(yb)
            total_rel_err += rel_err.item()
    return total_rel_err / len(loader)

def load_data(config):
    data = torch.load('synthetic_data_ns2d/synthetic_data.pt')
    x_all, y_all = data[:config['train_samples']+config['val_samples'], 0], data[:config['train_samples']+config['val_samples'], 1]
    dataset = TensorDataset(x_all, y_all)
    generator = torch.Generator().manual_seed(42)
    train_set, val_set = random_split(dataset, [config['train_samples'], config['val_samples']], generator=generator)
    return DataLoader(train_set, batch_size=config['batch_size'], shuffle=True), DataLoader(val_set, batch_size=config['batch_size'], shuffle=False)

def evaluate(model, val_loader, label=""):
    model.eval()
    with torch.no_grad():
        xb, yb = next(iter(val_loader))
        start = time.time()
        pred = model(xb)
        end = time.time()
        rel_err = torch.norm(pred - yb) / torch.norm(yb)
        time_per_sample = (end - start) / len(xb)
        print(f"\n === {label} Evaluation ===")
        print(f"Relative Error: {rel_err:.4e}")
        print(f"Inference Time per sample (CPU): {time_per_sample:.4e} s")
        print(f"Score (RelErr × Time × 1000): {rel_err * time_per_sample * 1000:.4e}")
        return rel_err.item(), time_per_sample

def train_baseline(config):
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    train_loader, val_loader = load_data(config)
    model = SimpleFNO(config['modes'], config['width']).to(device)
    optimizer = optim.Adam(model.parameters(), lr=0.0005)
    loss_fn = nn.MSELoss()
    for ep in range(1, config['epochs'] + 1):
        train_loss = train_epoch(model, train_loader, optimizer, loss_fn, device)
        val_err = test_model(model, val_loader, device)
        print(f"[Baseline Epoch {ep}] Train Loss: {train_loss:.6f} | Val RelErr: {val_err:.4e}")
    return model.cpu(), val_loader

def train_qat_int8(config):
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    train_loader, val_loader = load_data(config)
    model = QuantizedFNOSelective(config['modes'], config['width']).to(device)
    fuse_model(model)
    model.qconfig = quant.get_default_qat_qconfig('fbgemm')
    quant.prepare_qat(model, inplace=True)
    model.to(device)
    optimizer = optim.Adam(model.parameters(), lr=0.0005)
    loss_fn = nn.MSELoss()
    for ep in range(1, config['epochs'] + 1):
        train_loss = train_epoch(model, train_loader, optimizer, loss_fn, device)
        val_err = test_model(model, val_loader, device)
        print(f"[QAT Epoch {ep}] Train Loss: {train_loss:.6f} | Val RelErr: {val_err:.4e}")
    model.cpu()
    quantized_model = quant.convert(model.eval(), inplace=False)
    return quantized_model, val_loader

if __name__ == "__main__":
    print("=== Training Baseline ===")
    baseline_model, val_loader = train_baseline(base_config)
    baseline_stats = evaluate(baseline_model, val_loader, "Baseline")

    print("\n=== Training QAT Model ===")
    qat_model, val_loader = train_qat_int8(base_config)
    qat_stats = evaluate(qat_model, val_loader, "QAT INT8")

    # Plot comparison
    epochs = list(range(1, base_config['epochs'] + 1))
    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(6, 6), sharex=True)

    ax1.axhline(baseline_stats[0], label="Baseline RelErr", color='blue')
    ax1.axhline(qat_stats[0], label="QAT INT8 RelErr", color='orange')
    ax1.set_ylabel("Rel. Error")
    ax1.set_title("Validation Error and Inference Time")
    ax1.legend()
    ax1.grid(True)

    ax2.axhline(baseline_stats[1], label="Baseline Time", color='blue', linestyle="--")
    ax2.axhline(qat_stats[1], label="QAT INT8 Time", color='orange', linestyle="--")
    ax2.set_ylabel("Inference Time (s)")
    ax2.set_xlabel("Epoch")
    ax2.legend()
    ax2.grid(True)

    plt.tight_layout()
    plt.savefig("qat_vs_baseline_combined_fixed.png", dpi=300)
    print("\n Saved comparison plot as 'qat_vs_baseline_combined_fixed.png'")
