import torch
import torch.nn as nn
import torch.fft as fft
import torch.nn.functional as F
from torch.utils.data import DataLoader, TensorDataset, random_split
import matplotlib.pyplot as plt
import time
import pandas as pd
import os
from datetime import datetime

# === FIXED BASE CONFIG ===
base_config = {
    'modes': 16,
    'width': 96,
    'epochs': 100,
    'batch_size': 8,
    'dt': 0.01,
    'nu': 1e-3,
    'grid_size': 32,
    'train_samples': 9000,
    'val_samples': 1000
}

class SpectralConv2d(nn.Module):
    def __init__(self, in_channels, out_channels, modes):
        super().__init__()
        self.modes = modes
        self.weights = nn.Parameter((1 / (in_channels * out_channels)) *
                                    torch.rand(in_channels, out_channels, modes, modes, dtype=torch.cfloat))

    def compl_mul2d(self, input, weights):
        return torch.einsum("bixy, ioxy -> boxy", input, weights)

    def forward(self, x):
        B, C, H, W = x.shape
        x_ft = fft.fft2(x, norm="ortho")
        modes = min(self.modes, H, W)
        out_ft = torch.zeros(B, self.weights.shape[1], H, W, dtype=torch.cfloat, device=x.device)
        out_ft[:, :, :modes, :modes] = self.compl_mul2d(x_ft[:, :, :modes, :modes], self.weights[:, :, :modes, :modes])
        return fft.ifft2(out_ft, norm="ortho").real

class FNO2D(nn.Module):
    def __init__(self, modes, width):
        super().__init__()
        self.fc0 = nn.Linear(1, width)
        self.conv1 = SpectralConv2d(width, width, modes)
        self.conv2 = SpectralConv2d(width, width, modes)
        self.w1 = nn.Conv2d(width, width, 1)
        self.w2 = nn.Conv2d(width, width, 1)
        self.fc1 = nn.Linear(width, 128)
        self.fc2 = nn.Linear(128, 1)

    def forward(self, x):
        x = self.fc0(x.unsqueeze(-1)).permute(0, 3, 1, 2)
        x = F.gelu(self.conv1(x) + self.w1(x))
        x = F.gelu(self.conv2(x) + self.w2(x))
        x = x.permute(0, 2, 3, 1)
        return self.fc2(F.gelu(self.fc1(x))).squeeze(-1)

def classification_error(pred, yb):
    pred_classes = torch.round(pred)
    true_classes = torch.round(yb)
    num_correct = (pred_classes == true_classes).sum().item()
    num_total = yb.numel()
    return (num_total - num_correct) / num_total

result_cache = {}

def train_and_evaluate(config, device, log, param_name, val):
    key = tuple(sorted(config.items()))
    if key in result_cache:
        return result_cache[key]

    data = torch.load('synthetic_data_ns2d/synthetic_data.pt')
    total_needed = config['train_samples'] + config['val_samples']
    x_all, y_all = data[:total_needed, 0], data[:total_needed, 1]

    dataset = TensorDataset(x_all, y_all)
    generator = torch.Generator().manual_seed(42)
    train_set, val_set = random_split(dataset, [config['train_samples'], config['val_samples']], generator=generator)
    train_loader = DataLoader(train_set, batch_size=int(config['batch_size']), shuffle=True)
    val_loader = DataLoader(val_set, batch_size=int(config['batch_size']), shuffle=False)

    model = FNO2D(config['modes'], config['width']).to(device)
    optimizer = torch.optim.Adam(model.parameters(), lr=0.001)
    loss_fn = nn.MSELoss()

    for ep in range(int(config['epochs'])):
        model.train()
        running_loss = 0.0
        for xb, yb in train_loader:
            xb, yb = xb.to(device), yb.to(device)
            optimizer.zero_grad()
            loss = loss_fn(model(xb), yb)
            loss.backward()
            optimizer.step()
            running_loss += loss.item()

        epoch_log = f"Running: epoch {ep+1}/{int(config['epochs'])} | {param_name}={val}, grid={config['grid_size']}, loss={running_loss:.4f}\n"
        print(epoch_log.strip())
        log.write(epoch_log)
        log.flush()

    model.eval()
    xb, yb = next(iter(val_loader))
    xb, yb = xb.to(device), yb.to(device)
    start = time.time()
    with torch.no_grad():
        pred = model(xb)
    end = time.time()

    infer_time = (end - start) / len(xb)
    rel_err = classification_error(pred, yb)
    score = rel_err * (infer_time * 1000)

    result_cache[key] = (rel_err, infer_time, score)
    return rel_err, infer_time, score

def binary_search_param(param_name, param_values, out_dir, log):
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    left_val, right_val = float(min(param_values)), float(max(param_values))
    iteration = 1
    results = []

    log.write(f"\n===== Binary Search on {param_name} =====\n")
    while abs(right_val - left_val) > 1:
        mid_val = (left_val + right_val) // 2
        sweep_vals = [int(left_val), int(mid_val), int(right_val)]
        log.write(f"[Iteration {iteration}] {param_name} values: {sweep_vals}\n")
        print(f"[Iteration {iteration}] {param_name} values: {sweep_vals}")
        iteration += 1

        iter_results = []
        for val in sweep_vals:
            config = base_config.copy()
            config[param_name] = val

            rel_err, infer_time, score = train_and_evaluate(config, device, log, param_name, val)
            log_line = f"    → {param_name}={val}, Rel Err={rel_err:.4e}, Time={infer_time:.4e}, Score={score:.4e}\n"
            log.write(log_line)
            print(log_line.strip())
            results.append((val, rel_err, infer_time, score))
            iter_results.append((val, score))

        best_val = min(iter_results, key=lambda x: x[1])[0]
        if best_val <= mid_val:
            right_val = mid_val
        else:
            left_val = mid_val

    os.makedirs(out_dir, exist_ok=True)
    df = pd.DataFrame(results, columns=[param_name, 'Relative Error', 'Inference Time (s)', 'Score'])
    csv_path = os.path.join(out_dir, f"{timestamp}_binarysearch_{param_name}.csv")
    df.to_csv(csv_path, index=False)
    log.write(f"\nSaved CSV to: {csv_path}\n")
    print(f"Saved CSV to: {csv_path}\n")
    print("Search complete. Check log and CSV for results.")

# === MAIN EXECUTION ===
sweep_param = 'batch_size'
sweep_range = [2, 128]

output_dir = f"sweep_results/sweep_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
os.makedirs(output_dir, exist_ok=True)
log_path = os.path.join(output_dir, "search_log.txt")

with open(log_path, "w") as log_file:
    binary_search_param(sweep_param, sweep_range, output_dir, log_file)
