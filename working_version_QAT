import torch
import torch.nn as nn
import torch.nn.functional as F
import torch.fft as fft
from torch.utils.data import DataLoader, TensorDataset, random_split
import time, os, csv

# === CONFIG ===
base_config = {
    'modes': 32,
    'width': 256,
    'epochs': 20,
    'batch_size': 128,
    'dt': 0.0208,
    'nu': 1e-4,
    'grid_size': 32,
    'train_samples': 9000,
    'val_samples': 1000,
    'freeze_epoch': 2
}

class SpectralConv2d(nn.Module):
    def __init__(self, in_channels, out_channels, modes):
        super().__init__()
        self.weights = nn.Parameter((1 / (in_channels * out_channels)) *
                                    torch.rand(in_channels, out_channels, modes, modes, dtype=torch.cfloat))
        self.modes = modes

    def compl_mul2d(self, input, weights):
        return torch.einsum("bixy, ioxy -> boxy", input, weights)

    def forward(self, x):
        B, C, H, W = x.shape
        x_ft = fft.fft2(x, norm="ortho")
        x_ft = x_ft[:, :, :self.modes, :self.modes]
        out_ft = torch.zeros(B, self.weights.shape[1], H, W, dtype=torch.cfloat, device=x.device)
        out_ft[:, :, :self.modes, :self.modes] = self.compl_mul2d(x_ft, self.weights)
        return fft.ifft2(out_ft, norm="ortho").real

class QuantFNO2D(nn.Module):
    def __init__(self, modes, width):
        super().__init__()
        self.quant = torch.quantization.QuantStub()
        self.fc0 = nn.Linear(1, width)  # will be quantized
        self.conv1 = SpectralConv2d(width, width, modes)
        self.conv2 = SpectralConv2d(width, width, modes)
        self.block1 = nn.Sequential(nn.Conv2d(width, width, 1), nn.ReLU())  # will be fused & quantized
        self.block2 = nn.Sequential(nn.Conv2d(width, width, 1), nn.ReLU())
        self.fc1 = nn.Linear(width, 128)  # quantized
        self.relu = nn.ReLU()
        self.fc2 = nn.Linear(128, 1)  # quantized
        self.dequant = torch.quantization.DeQuantStub()

    def forward(self, x):
        x = self.quant(x)
        x = self.fc0(x.unsqueeze(-1))  # quantized linear
        x = self.dequant(x)  # float for FFT ops

        x = x.permute(0, 3, 1, 2)
        x = self.relu(self.conv1(x))
        x = self.relu(self.conv2(x))

        x = self.quant(x)
        x = self.block1(x)
        x = self.block2(x)

        x = x.permute(0, 2, 3, 1)
        x = self.fc2(self.relu(self.fc1(x)))  # quantized linear
        x = self.dequant(x)
        return x.squeeze(-1)

def fuse_model(model):
    torch.quantization.fuse_modules(model, [['block1.0', 'block1.1'], ['block2.0', 'block2.1']], inplace=True)

def classification_error(pred, yb):
    pred_classes = torch.round(pred)
    true_classes = torch.round(yb)
    num_correct = (pred_classes == true_classes).sum().item()
    num_total = yb.numel()
    return (num_total - num_correct) / num_total

def run_single_config(config):
    torch.backends.quantized.engine = 'fbgemm'
    train_device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    infer_device = torch.device("cpu")
    print(f"Training on: {train_device}, Inference on: {infer_device}")

    # === Load Data ===
    data = torch.load('synthetic_data_ns2d/synthetic_data.pt')
    total_needed = config['train_samples'] + config['val_samples']
    x_all, y_all = data[:total_needed, 0], data[:total_needed, 1]

    dataset = TensorDataset(x_all, y_all)
    generator = torch.Generator().manual_seed(42)
    train_set, val_set = random_split(dataset, [config['train_samples'], config['val_samples']], generator=generator)
    train_loader = DataLoader(train_set, batch_size=config['batch_size'], shuffle=True)
    val_loader = DataLoader(val_set, batch_size=config['batch_size'], shuffle=False)

    # === Model Setup ===
    model = QuantFNO2D(config['modes'], config['width']).to(train_device)
    fuse_model(model)

    model.qconfig = torch.quantization.get_default_qat_qconfig('fbgemm')
    for name, module in model.named_modules():
        if isinstance(module, SpectralConv2d):
            module.qconfig = None  # Skip quantizing FFT layers

    torch.quantization.prepare_qat(model, inplace=True)

    optimizer = torch.optim.Adam(model.parameters(), lr=0.001)
    loss_fn = nn.MSELoss()

    os.makedirs("logs", exist_ok=True)
    csv_path = "logs/qat_fused_training_log.csv"
    with open(csv_path, "w", newline='') as f:
        csv.writer(f).writerow(["Epoch", "Train Loss", "Val Rel Error", "Time (s)", "Infer/sample"])

    for ep in range(config['epochs']):
        model.train()
        total_loss = 0
        start_ep = time.time()
        for xb, yb in train_loader:
            xb, yb = xb.to(train_device), yb.to(train_device)
            optimizer.zero_grad()
            loss = loss_fn(model(xb), yb)
            loss.backward()
            optimizer.step()
            total_loss += loss.item()
        duration = time.time() - start_ep
        avg_loss = total_loss / len(train_loader)

        # Per-epoch val rel error and inference time
        model.eval()
        xb, yb = next(iter(val_loader))
        xb, yb = xb.to(train_device), yb.to(train_device)
        with torch.no_grad():
            start = time.time()
            pred = model(xb)
            end = time.time()
        rel_err = classification_error(pred, yb)
        infer_time = (end - start) / len(xb)

        with open(csv_path, "a", newline='') as f:
            csv.writer(f).writerow([ep + 1, avg_loss, rel_err, duration, infer_time])

        print(f"[Epoch {ep+1}] Train Loss: {avg_loss:.6f} | Val RelErr: {rel_err:.4e} | Time: {duration:.2f}s | Infer/sample: {infer_time:.4e}s")

        model.train()
        if ep + 1 == config['freeze_epoch']:
            print(f"Freezing observers at epoch {ep+1}...")
            model.apply(torch.quantization.disable_observer)

    # === Convert for Inference ===
    print("Converting model to int8 for CPU inference...")
    model.to(infer_device)
    model.eval()
    torch.quantization.convert(model, inplace=True)

    # === Final Evaluation ===
    xb, yb = next(iter(val_loader))
    xb, yb = xb.to(infer_device), yb.to(infer_device)
    start = time.time()
    with torch.no_grad():
        pred = model(xb)
    end = time.time()
    infer_time = (end - start) / len(xb)
    rel_err = classification_error(pred, yb)
    score = rel_err * (infer_time * 1000)

    print(f"\n === Final Quantized Inference ===")
    print(f"Relative Error: {rel_err:.4e}")
    print(f"Inference Time per sample (CPU): {infer_time:.4e} seconds")
    print(f"Score (RelErr × Time × 1000): {score:.4e}")
    print(f"Training log saved to {csv_path}")

# === RUN ===
run_single_config(base_config)
