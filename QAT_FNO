import torch
import torch.nn as nn
import torch.fft as fft
import torch.nn.functional as F
import torch.quantization as tq
from torch.utils.data import DataLoader, TensorDataset, random_split
import time
import csv
import os
import matplotlib.pyplot as plt

# === CONFIG ===
config = {
    'modes': 32,
    'width': 256,
    'epochs': 10,
    'batch_size': 128,
    'dt': 0.0208,
    'nu': 1e-4,
    'grid_size': 32,
    'train_samples': 9000,
    'val_samples': 1000
}

class SpectralConv2d(nn.Module):
    def __init__(self, in_channels, out_channels, modes):
        super().__init__()
        self.weights = nn.Parameter((1 / (in_channels * out_channels)) *
                                    torch.rand(in_channels, out_channels, modes, modes, dtype=torch.cfloat))
        self.modes = modes

    def compl_mul2d(self, input, weights):
        return torch.einsum("bixy, ioxy -> boxy", input, weights)

    def forward(self, x):
        B, C, H, W = x.shape
        x_ft = fft.fft2(x, norm="ortho")
        x_ft = x_ft[:, :, :self.modes, :self.modes]
        out_ft = torch.zeros(B, self.weights.shape[1], H, W, dtype=torch.cfloat, device=x.device)
        out_ft[:, :, :self.modes, :self.modes] = self.compl_mul2d(x_ft, self.weights)
        return fft.ifft2(out_ft, norm="ortho").real

class FNO2D_QAT(nn.Module):
    def __init__(self, modes, width):
        super().__init__()
        self.fc0 = nn.Linear(1, width)
        self.quant = tq.QuantStub()
        self.conv1 = SpectralConv2d(width, width, modes)
        self.conv2 = SpectralConv2d(width, width, modes)
        self.w1 = nn.Conv2d(width, width, 1)
        self.w2 = nn.Conv2d(width, width, 1)
        self.fc1 = nn.Linear(width, 128)
        self.fc2 = nn.Linear(128, 1)
        self.dequant = tq.DeQuantStub()

    def forward(self, x):
        x = x.unsqueeze(-1)
        x = self.fc0(x)
        x = self.quant(x).permute(0, 3, 1, 2)
        x = F.gelu(self.conv1(x) + self.w1(x))
        x = F.gelu(self.conv2(x) + self.w2(x))
        x = x.permute(0, 2, 3, 1)
        x = self.fc2(F.gelu(self.fc1(x))).squeeze(-1)
        return self.dequant(x)

def relative_l2_error(pred, target):
    return torch.norm(pred - target) / torch.norm(target)

def train_and_evaluate_qat(config):
    # === Load data ===
    data = torch.load('synthetic_data_ns2d/synthetic_data.pt')
    total_needed = config['train_samples'] + config['val_samples']
    x_all, y_all = data[:total_needed, 0], data[:total_needed, 1]

    dataset = TensorDataset(x_all, y_all)
    train_set, val_set = random_split(dataset, [config['train_samples'], config['val_samples']], generator=torch.Generator().manual_seed(42))
    train_loader = DataLoader(train_set, batch_size=config['batch_size'], shuffle=True)
    val_loader = DataLoader(val_set, batch_size=config['batch_size'], shuffle=False)

    # === Build model ===
    model = FNO2D_QAT(config['modes'], config['width'])
    model.qconfig = tq.get_default_qat_qconfig('fbgemm')
    tq.prepare_qat(model, inplace=True)  # QAT preparation

    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    model.to(device)
    optimizer = torch.optim.Adam(model.parameters(), lr=0.001)
    loss_fn = nn.MSELoss()

    os.makedirs("logs", exist_ok=True)
    with open("logs/qat_training_log.csv", "w", newline='') as f:
        csv.writer(f).writerow(["Epoch", "Train Loss", "Time (s)"])

    print("Starting QAT training...")
    train_log = []
    for ep in range(config['epochs']):
        model.train()

        if ep == 10:
            model.apply(torch.quantization.disable_observer)

        total_loss = 0
        start_ep = time.time()
        for xb, yb in train_loader:
            xb, yb = xb.to(device), yb.to(device)
            optimizer.zero_grad()
            loss = loss_fn(model(xb), yb)
            loss.backward()
            optimizer.step()
            total_loss += loss.item()
        duration = time.time() - start_ep
        avg_loss = total_loss / len(train_loader)
        train_log.append(avg_loss)
        with open("logs/qat_training_log.csv", "a", newline='') as f:
            csv.writer(f).writerow([ep + 1, avg_loss, duration])
        print(f"[Epoch {ep+1}] Train Loss: {avg_loss:.6f} | Time: {duration:.2f}s")

    # === Evaluate (without torch.quantization.convert) ===
    model.to('cpu')
    model.eval()

    xb, yb = next(iter(val_loader))
    xb, yb = xb.to('cpu'), yb.to('cpu')
    start = time.time()
    with torch.no_grad():
        pred = model(xb)
    end = time.time()

    infer_time = (end - start) / len(xb)
    rel_err = relative_l2_error(pred, yb).item()

    with open("logs/qat_eval_metrics.csv", "w", newline='') as f:
        csv.writer(f).writerow(["Relative Error", "Inference Time (s/sample)"])
        csv.writer(f).writerow([rel_err, infer_time])

    print(f"\n=== QAT FNO CPU Inference (Fake Quant) ===")
    print(f"Relative Error: {rel_err:.4e}")
    print(f"Inference Time per sample (on CPU): {infer_time:.4e} seconds")
    print(f"Training log saved to logs/qat_training_log.csv")

    # === Plot ===
    plt.figure(figsize=(6, 4))
    plt.plot(range(1, config['epochs'] + 1), train_log, label="Train Loss")
    plt.xlabel("Epoch")
    plt.ylabel("MSE Loss")
    plt.title("QAT-FNO Training Loss (Fake Quant)")
    plt.grid(True)
    plt.tight_layout()
    plt.savefig("logs/qat_training_curve.png")
    plt.show()
    
    return model

# === RUN ===
train_and_evaluate_qat(config)

# === Save trained QAT model state ===
model = train_and_evaluate_qat(config)
torch.save(model.state_dict(), "qat_fno_trained.pth")
print("Saved model as qat_fno_trained.pth")
