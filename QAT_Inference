import torch
import torch.nn as nn
import torch.nn.functional as F
import torch.fft as fft
import torch.quantization as tq
import time
import os

# === Model Definition ===
class SpectralConv2d(nn.Module):
    def __init__(self, in_channels, out_channels, modes):
        super().__init__()
        self.weights = nn.Parameter((1 / (in_channels * out_channels)) *
                                    torch.rand(in_channels, out_channels, modes, modes, dtype=torch.cfloat))
        self.modes = modes

    def compl_mul2d(self, input, weights):
        return torch.einsum("bixy, ioxy -> boxy", input, weights)

    def forward(self, x):
        B, C, H, W = x.shape
        x_ft = fft.fft2(x, norm="ortho")
        x_ft = x_ft[:, :, :self.modes, :self.modes]
        out_ft = torch.zeros(B, self.weights.shape[1], H, W, dtype=torch.cfloat, device=x.device)
        out_ft[:, :, :self.modes, :self.modes] = self.compl_mul2d(x_ft, self.weights)
        return fft.ifft2(out_ft, norm="ortho").real

class FNO2D_QAT(nn.Module):
    def __init__(self, modes, width):
        super().__init__()
        self.quant = tq.QuantStub()
        self.fc0 = nn.Linear(1, width)
        self.conv1 = SpectralConv2d(width, width, modes)
        self.conv2 = SpectralConv2d(width, width, modes)
        self.w1 = nn.Conv2d(width, width, 1)
        self.w2 = nn.Conv2d(width, width, 1)
        self.fc1 = nn.Linear(width, 128)
        self.fc2 = nn.Linear(128, 1)
        self.dequant = tq.DeQuantStub()

    def forward(self, x):
        x = x.unsqueeze(-1)                      # [B, H, W, 1]
        x = self.fc0(x)                          # [B, H, W, width]
        x = self.quant(x).permute(0, 3, 1, 2)    # [B, width, H, W]
        x = F.gelu(self.conv1(x) + self.w1(x))
        x = F.gelu(self.conv2(x) + self.w2(x))
        x = x.permute(0, 2, 3, 1)                # [B, H, W, width]
        x = self.fc1(x)
        x = F.gelu(x)
        x = self.fc2(x).squeeze(-1)              # [B, H, W]
        x = self.dequant(x)
        return x

# === Load and Convert ===
print("Working directory:", os.getcwd())
model = FNO2D_QAT(modes=32, width=256)
model.qconfig = tq.get_default_qconfig('fbgemm')
tq.prepare(model, inplace=True)

state_path = "qat_fno_trained.pth"
assert os.path.exists(state_path), f"File not found: {state_path}"
state_dict = torch.load(state_path, map_location="cpu")
model.load_state_dict(state_dict, strict=False)

try:
    tq.convert(model, inplace=True)
    model.eval()
    print("Model converted to INT8.")
except Exception as e:
    print("Quantization failed:", e)
    exit(1)

# === Dummy Inference ===
x = torch.rand(1, 32, 32)  # single NS2D sample
start = time.time()
with torch.no_grad():
    y = model(x)
end = time.time()

print("INT8 inference completed")
print("Output shape:", y.shape)
print(f"Inference time: {(end - start) * 1000:.2f} ms")
