# === IMPORTS ===
import torch
import torch.nn as nn
import torch.nn.functional as F
import torch.fft
import time
import warnings
from torch.utils.data import DataLoader, TensorDataset, random_split

warnings.filterwarnings("ignore", message=".*quant_min and quant_max.*")

# === CONFIG ===
BATCH_SIZE = 128
TRAIN_SAMPLES = 9000
VAL_SAMPLES = 1000
MODES = 32
WIDTH = 256
EPOCHS = 500
DT = 0.0208
NU = 1e-4

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print(f"[Device] Training float32 model on: {device}")

# === PARAM AUGMENTATION ===
def augment_with_params(X, dt=DT, nu=NU):
    B, _, H, W = X.shape
    dt_channel = torch.full((B, 1, H, W), dt, dtype=X.dtype, device=X.device)
    nu_channel = torch.full((B, 1, H, W), nu, dtype=X.dtype, device=X.device)
    return torch.cat([X, dt_channel, nu_channel], dim=1)

# === LOAD DATA ===
print("[Step] Loading dataset...")
data = torch.load("synthetic_data_ns2d/synthetic_data.pt")
X_raw = data[:TRAIN_SAMPLES + VAL_SAMPLES, 0].unsqueeze(1)
Y = data[:TRAIN_SAMPLES + VAL_SAMPLES, 1].unsqueeze(1)
X = augment_with_params(X_raw)
train_set, val_set = random_split(TensorDataset(X, Y), [TRAIN_SAMPLES, VAL_SAMPLES])
train_loader = DataLoader(train_set, batch_size=BATCH_SIZE, shuffle=True)
val_loader = DataLoader(val_set, batch_size=BATCH_SIZE)
print("[Step] Dataset ready")

# === SPECTRAL CONV2D ===
class SpectralConv2d(nn.Module):
    def __init__(self, in_channels, out_channels, modes):
        super().__init__()
        self.in_channels = in_channels
        self.out_channels = out_channels
        self.modes = modes
        self.scale = 1 / (in_channels * out_channels)
        self.weights = nn.Parameter(
            self.scale * torch.randn(in_channels, out_channels, modes, modes, dtype=torch.cfloat)
        )

    def compl_mul2d(self, input, weights):
        return torch.einsum("bixy,ioxy->boxy", input, weights)

    def forward(self, x):
        B, C, H, W = x.shape
        x_ft = torch.fft.rfft2(x)
        Hf, Wf = x_ft.shape[-2], x_ft.shape[-1]
        mh = min(self.modes, Hf)
        mw = min(self.modes, Wf)
        out_ft = torch.zeros(B, self.out_channels, Hf, Wf, dtype=torch.cfloat, device=x.device)
        out_ft[:, :, :mh, :mw] = self.compl_mul2d(x_ft[:, :, :mh, :mw], self.weights[:, :, :mh, :mw])
        x = torch.fft.irfft2(out_ft, s=(H, W))
        return x

# === FNO2D MODEL (RELU version) ===
class FNO2D(nn.Module):
    def __init__(self, modes=MODES, width=WIDTH):
        super().__init__()
        self.fc0 = nn.Conv2d(3, width, 1)

        self.spec1 = SpectralConv2d(width, width, modes)
        self.spec2 = SpectralConv2d(width, width, modes)
        self.spec3 = SpectralConv2d(width, width, modes)
        self.spec4 = SpectralConv2d(width, width, modes)

        self.w1 = nn.Conv2d(width, width, 1)
        self.w2 = nn.Conv2d(width, width, 1)
        self.w3 = nn.Conv2d(width, width, 1)
        self.w4 = nn.Conv2d(width, width, 1)

        self.bn1 = nn.BatchNorm2d(width)
        self.bn2 = nn.BatchNorm2d(width)
        self.bn3 = nn.BatchNorm2d(width)
        self.bn4 = nn.BatchNorm2d(width)

        self.fc1 = nn.Conv2d(width, 32, 1)
        self.fc2 = nn.Conv2d(32, 1, 1)

    def forward(self, x):
        x = self.fc0(x)
        x = self.bn1(F.relu(self.spec1(x) + self.w1(x)))
        x = self.bn2(F.relu(self.spec2(x) + self.w2(x)))
        x = self.bn3(F.relu(self.spec3(x) + self.w3(x)))
        x = self.bn4(F.relu(self.spec4(x) + self.w4(x)))
        x = F.relu(self.fc1(x))
        x = self.fc2(x)
        return x

# === MODEL TRAINING ===
print("[Step] Starting float32 training...")
model = FNO2D().to(device).train()
optimizer = torch.optim.Adam(model.parameters(), lr=1e-3)
loss_fn = nn.MSELoss()

for epoch in range(EPOCHS):
    total_loss = 0.0
    for xb, yb in train_loader:
        xb, yb = xb.to(device), yb.to(device)
        optimizer.zero_grad()
        pred = model(xb)
        loss = loss_fn(pred, yb)
        loss.backward()
        optimizer.step()
        total_loss += loss.item()
    print(f"[Epoch {epoch+1}] Train Loss: {total_loss / len(train_loader):.6f}")
print("[Step] Training complete")

# === CPU INFERENCE ===
print("[Step] Running float32 inference on CPU...")
model.cpu().eval()

total_rel_err = 0.0
total_time = 0.0
total_samples = 0

with torch.no_grad():
    for i, (xb, yb) in enumerate(val_loader):
        start = time.time()
        pred = model(xb)
        end = time.time()

        elapsed = (end - start) * 1000  # ms
        batch_size = xb.size(0)
        per_sample = elapsed / batch_size

        rel_err = (torch.norm(pred - yb) / torch.norm(yb)).item()
        total_rel_err += rel_err
        total_time += elapsed
        total_samples += batch_size

        print(f"[Batch {i+1}] Time: {elapsed:.2f} ms | Per sample: {per_sample:.4f} ms | RelErr: {rel_err:.6f}")

avg_rel_err = total_rel_err / len(val_loader)
avg_batch_time = total_time / len(val_loader)
avg_sample_time = total_time / total_samples

print("\n[Step] Float32 Evaluation Summary")
print(f"Avg Relative L2 Error: {avg_rel_err:.6f}")
print(f"Avg Inference Time (batch): {avg_batch_time:.2f} ms")
print(f"Avg Inference Time (sample): {avg_sample_time:.4f} ms")
